# sub2api 实例 base URL（不含尾部 /）
SUB2API_BASE_URL=https://your-sub2api.example.com

# sub2api 管理员 API Key（在 sub2api 后台 → 系统设置 中生成）
SUB2API_ADMIN_KEY=replace-me

# Web 登录密码（你自己定的访问密码）
LOGIN_PASSWORD=change-this-password

# Session 签名密钥；生成命令：openssl rand -hex 32
SESSION_SECRET=replace-with-openssl-rand-hex-32

# 上游请求超时（秒）
REQUEST_TIMEOUT=30

# ============ 安全配置 ============

# Cookie secure 标志（生产环境必须为 true，本地 HTTP 开发可设为 false）
COOKIE_SECURE=true

# 调试模式（生产环境必须为 false，开发环境可设为 true）
DEBUG=false

# 自签证书路径（如果上游使用自签证书，提供证书路径；否则留空使用系统 CA）
# 示例: SUB2API_CA_BUNDLE=/path/to/ca-bundle.crt
SUB2API_CA_BUNDLE=

TZ=Asia/Shanghai